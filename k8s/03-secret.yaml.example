# from task 2 - k8s secret for the chaos endpoint token
# real value is never committed, create it with: scripts/create-app-secret.sh
# named .example so "kubectl apply -f k8s/" skips it and doesnt overwrite the real token
# (db password is NOT here, it comes from secret manager, see 04-secretproviderclass.yaml)
apiVersion: v1
kind: Secret
metadata:
  name: app-chaos
  namespace: app
type: Opaque
stringData:
  token: "REPLACE_ME"
